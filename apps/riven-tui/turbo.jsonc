{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tags": ["type:app"],
  "tasks": {
    "codegen:gql": {
      "inputs": [
        "lib/**/*.ts",
        "!lib/**/__generated__/**/*",
        "!lib/**/*.typegen.ts",
        "graphql.config.ts"
      ],
      "outputs": ["lib/types/__generated__/graphql.ts", "lib/**/*.typegen.ts"]
    },
    "build": {
      "dependsOn": ["$TURBO_EXTENDS$", "codegen:gql"]
    },
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "codegen:gql"]
    },
    "lint": {
      "dependsOn": ["$TURBO_EXTENDS$", "codegen:gql"]
    },
    "dev": {
      "dependsOn": ["$TURBO_EXTENDS$", "codegen:gql"],
      "passThroughEnv": [
        "RIVEN_TUI_SETTING__graphqlUrl",
        "RIVEN_TUI_SETTING__apiKey"
      ]
    },
    "start": {
      "dependsOn": ["$TURBO_EXTENDS$", "build"],
      "passThroughEnv": [
        "RIVEN_TUI_SETTING__graphqlUrl",
        "RIVEN_TUI_SETTING__apiKey"
      ]
    }
  }
}
