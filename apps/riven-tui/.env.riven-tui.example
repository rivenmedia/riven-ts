# The GraphQL endpoint of the running Riven instance to connect to.
RIVEN_TUI_SETTING__graphqlUrl="http://localhost:3000/graphql"

# The Riven instance's API key, the value of its RIVEN_SETTING__apiKey. Riven rejects requests without it.
RIVEN_TUI_SETTING__apiKey=""

# Enable debug
RIVEN_TUI_SETTING__enableDebug="false"
