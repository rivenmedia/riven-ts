{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": "@repo/core-util-typescript-config/base.json",
  "compilerOptions": {
    "target": "ES2017",
    "allowJs": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "exactOptionalPropertyTypes": false,
    "rewriteRelativeImportExtensions": false,
    "allowImportingTsExtensions": true,
    "plugins": [{ "name": "next" }]
  },
  "files": ["next-env.d.ts"],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/*.d.ts",
    ".next/dev/types/*.d.ts",
    ".source/**/*.ts"
  ],
  "exclude": []
}
