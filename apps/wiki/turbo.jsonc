{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^codegen:config-docs"],
      "outputs": ["$TURBO_EXTENDS$", ".next/**", "out/**"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/**/*.{md,mdx}",
        // Plugin display names and nav ordering live in fumadocs meta files
        "$TURBO_ROOT$/**/docs/**/meta.json"
      ]
    },
    "dev": {
      "dependsOn": ["^codegen:config-docs"]
    }
  }
}
