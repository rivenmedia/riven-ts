{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "noEmit": false,
    "types": []
  },
  "files": ["vitest.setup.ts", "extend-zod-global-registry.d.ts"],
  "include": [
    "next-env.d.ts",
    ".next/types/*.d.ts",
    ".next/dev/types/*.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/**/*.mts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "components/**/*.mts",
    "environment/**/*.ts",
    "environment/**/*.tsx",
    "environment/**/*.mts",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "lib/**/*.mts"
  ],
  "exclude": ["**/*.stories.tsx"]
}
