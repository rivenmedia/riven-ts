{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "with": ["@repo/riven#dev"]
    },
    "codegen:gql": {
      "dependsOn": ["@repo/riven#codegen:gql-schema"]
    },
    "codegen:gql:watch": {
      "dependsOn": ["@repo/riven#codegen:gql-schema"],
      "cache": false,
      "persistent": true
    },
    "e2e": {
      "passThroughEnv": ["DATABASE_FILE_NAME"]
    },
    "e2e:headless": {},
    "storybook": {
      "cache": false,
      "persistent": true,
      "with": ["codegen:gql:watch"]
    },
    "build-storybook": {
      "dependsOn": ["codegen:gql"],
      "inputs": [".storybook/**", "{app,components,lib}/**/*.tsx?"],
      "outputs": ["storybook-static"]
    },
    "chromatic": {
      "passThroughEnv": ["CHROMATIC_PROJECT_TOKEN"],
      "dependsOn": ["transit:source-files"],
      "inputs": ["{app,components,lib}/**/*.tsx?"]
    }
  }
}
