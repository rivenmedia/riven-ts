{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "cache": false,
      "with": ["@repo/riven#dev", "codegen:gql:watch"],
      "persistent": true,
      "passThroughEnv": ["NEXT_RUNTIME"]
    },
    "lint": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@repo/util-plugin-sdk#build",
        "codegen:nextjs-types",
        "codegen:gql"
      ]
    },
    "codegen:gql": {
      "dependsOn": ["@repo/riven#codegen:gql-schema"]
    },
    "codegen:gql:watch": {
      "dependsOn": ["@repo/riven#codegen:gql-schema"],
      "cache": false,
      "persistent": true
    },
    "msw:init": {
      "cache": false
    },
    "storybook": {
      "dependsOn": ["msw:init"],
      "cache": false,
      "persistent": true,
      "with": ["codegen:gql:watch"]
    },
    "build-storybook": {
      "dependsOn": ["msw:init", "codegen:gql"],
      "inputs": [".storybook/**", "{app,components,lib}/**/*.{ts,tsx}"],
      "outputs": ["storybook-static"]
    },
    "test:visual": {
      "dependsOn": ["codegen:api-schemas", "transit:source-files"],
      "env": ["VISUAL_TESTS"],
      "inputs": [
        "**/*.{ts,tsx,mts,mtsx,cts,ctsx,js,jsx,mjs,mjsx,cjs,cjsx,json,jsonc,json5,css}",
        "public/**",
        "!**/{logs,node_modules,temp,.turbo,__generated__,__screenshots__,.next,coverage,docker-data,dist}/**",
        "!*.md"
      ],
      "outputs": ["__screenshots__/**"]
    }
  }
}
