{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "cache": false,
      "with": ["@repo/riven#dev", "codegen:gql:watch"],
      "persistent": true,
      "passThroughEnv": ["NEXT_RUNTIME"]
    },
    "lint": {
      "dependsOn": ["$TURBO_EXTENDS$", "codegen:nextjs-types", "codegen:gql"]
    },
    "codegen:gql": {
      "dependsOn": ["@repo/riven#codegen:gql-schema"],
      "outputs": [
        "./app/_types/__generated__/graphql.ts",
        "./app/**/*.typegen.ts"
      ]
    },
    "codegen:gql:watch": {
      "dependsOn": ["@repo/riven#codegen:gql-schema"],
      "cache": false,
      "persistent": true
    },
    "msw:init": {
      "cache": false
    },
    "storybook": {
      "dependsOn": ["msw:init"],
      "cache": false,
      "persistent": true,
      "with": ["codegen:gql:watch"]
    },
    "build-storybook": {
      "dependsOn": ["msw:init", "codegen:gql"],
      "inputs": [".storybook/**", "{app,components,lib}/**/*.{ts,tsx}"],
      "outputs": ["storybook-static"]
    },
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        // Ignore unrelated NextJS files
        "!{proxy,instrumentation,instrumentation-client}.ts",
        // Ignore E2E code
        "!playwright/**",
        "!tests/**",
        // Ignore unrelated config files
        "!**/*.config.ts",
        // Component tests are ran via Vitest, so explicitly include its config
        "vitest.config.ts",
        // Ignore stories for unit tests
        "!**/*.stories.tsx",
        // Ignore generated types, these are missing on a fresh checkout and cause cache misses
        "!**/*.typegen.ts",
        "!**/next-env.d.ts",
        "!**/public/mockServiceWorker.js"
      ]
    },
    "test:component": {
      "inputs": [
        "$TURBO_EXTENDS$",
        // Ignore unrelated NextJS files
        "!{proxy,instrumentation,instrumentation-client}.ts",
        // Ignore E2E code
        "!playwright/**",
        "!tests/**",
        // Ignore unrelated config files
        "!**/*.config.ts",
        // Component tests are ran via Vitest, so explicitly include its config
        "vitest.config.ts",
        // Ignore generated types, these are missing on a fresh checkout and cause cache misses
        "!**/*.typegen.ts",
        "!**/next-env.d.ts",
        "!**/public/mockServiceWorker.js"
      ]
    }
  }
}
