{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "with": ["@repo/riven#dev"]
    },
    "codegen:gql": {
      "dependsOn": ["@repo/riven#codegen:gql-schema"]
    },
    "codegen:gql:watch": {
      "dependsOn": ["@repo/riven#codegen:gql-schema"],
      "cache": false,
      "persistent": true
    },
    "e2e": {
      "passThroughEnv": ["DATABASE_FILE_NAME"]
    },
    "e2e:headless": {},
    "msw:init": {
      "cache": false
    },
    "storybook": {
      "dependsOn": ["msw:init"],
      "cache": false,
      "persistent": true,
      "with": ["codegen:gql:watch"]
    },
    "build-storybook": {
      "dependsOn": ["msw:init", "codegen:gql"],
      "inputs": [".storybook/**", "{app,components,lib}/**/*.{ts,tsx}"],
      "outputs": ["storybook-static"]
    },
    "chromatic": {
      "passThroughEnv": ["CHROMATIC_PROJECT_TOKEN"],
      "dependsOn": ["msw:init", "transit:source-files"],
      "inputs": ["{app,components,lib}/**/*.{ts,tsx}"]
    }
  }
}
