{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "cache": false,
      "with": ["@repo/riven#dev", "codegen:gql:watch"],
      "persistent": true,
      "passThroughEnv": ["NEXT_RUNTIME"]
    },
    "lint": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@repo/util-plugin-sdk#build",
        "codegen:nextjs-types",
        "codegen:gql"
      ]
    },
    "codegen:gql": {
      "dependsOn": ["@repo/riven#codegen:gql-schema"]
    },
    "codegen:gql:watch": {
      "dependsOn": ["@repo/riven#codegen:gql-schema"],
      "cache": false,
      "persistent": true
    },
    "msw:init": {
      "cache": false
    },
    "storybook": {
      "dependsOn": ["msw:init"],
      "cache": false,
      "persistent": true,
      "with": ["codegen:gql:watch"]
    },
    "build-storybook": {
      "dependsOn": ["msw:init", "codegen:gql"],
      "inputs": [".storybook/**", "{app,components,lib}/**/*.{ts,tsx}"],
      "outputs": ["storybook-static"]
    },
    "test:component": {
      "inputs": [
        "$TURBO_EXTENDS$",
        // Changes to styles, static assets or baselines all affect the visual snapshots
        "**/*.css",
        "public/**",
        "__vis__/docker/__baselines__/**"
      ],
      "outputs": ["__vis__/**/__results__/**", "__vis__/**/__diffs__/**"],
      // Switches to the containerised browser. Not part of the hash, as the endpoint's port changes on every run.
      "passThroughEnv": ["VIS_BROWSER_WS_ENDPOINT"]
    }
  }
}
