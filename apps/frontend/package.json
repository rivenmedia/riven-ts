  "type": "module",
  "exports": {
    "./wiki.config": "./wiki.config.ts"
  },
  "scripts": {
    "auth:generate": "pnpx auth generate --config ./lib/auth.ts --output ./lib/database/schema/ba-auth.ts --yes",
    "build": "next build",
    "build-storybook": "storybook build",
    "chromatic": "pnpx chromatic",
    "codegen:gql": "graphql-codegen --config graphql.config.ts",
    "codegen:gql:watch": "pnpm codegen:gql --watch",
    "codegen:nextjs-types": "nextjs typegen",
    "dev": "next dev -p 9000 --experimental-https",
    "e2e": "playwright test --ui",
    "e2e:headless": "playwright test",
    "lint": "oxlint --type-aware --type-check --report-unused-disable-directives-severity=warn",
    "lint:fix": "pnpm lint --fix",
    "msw:init": "msw init",
    "postinstall": "msw init",
    "start": "next start",
    "storybook": "storybook dev -p 6006 --no-open",
    "test": "vitest run --project unit",
    "test:component": "vitest run --project storybook",
    "test:watch": "vitest watch"
  },
