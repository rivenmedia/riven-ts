{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": false,
    "types": []
  },
  "files": ["extend-zod-global-registry.d.ts"],
  "include": [
    "instrumentation-client.ts",
    "next-env.d.ts",
    ".next/types/*.d.ts",
    ".next/dev/types/*.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/**/*.mts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "components/**/*.mts",
    "environment/**/*.ts",
    "environment/**/*.tsx",
    "environment/**/*.mts",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "lib/**/*.mts"
  ],
  "exclude": ["**/*.spec.ts", "**/__tests__/**/*.ts", "**/*.stories.tsx"]
}
