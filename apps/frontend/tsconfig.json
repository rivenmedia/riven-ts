{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": "@repo/core-util-typescript-config/base.json",
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.spec.json" },
    { "path": "./tsconfig.storybook.json" }
  ],
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/app/*": ["./app/*"],
      "@/components/*": ["./components/*"],
      "@/environment/*": ["./environment/*"],
      "@/lib/*": ["./lib/*"],
      "@/.storybook/*": ["./.storybook/*"],
      "@/playwright/*": ["./playwright/*"]
    }
  },
  "files": [
    "chromatic.config.json",
    "components.json",
    "graphql.config.ts",
    "next-env.d.ts",
    "next.config.ts",
    "oxlint.config.ts",
    "playwright.config.ts",
    "proxy.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "wiki.config.ts"
  ],
  "include": [],
  "exclude": []
}
