{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "sortImports": {
    "internalPattern": ["~/", "@/", "@repo/", "#"],
    "sortSideEffects": false,
    "groups": [
      "internal",
      ["builtin", "external"],
      "subpath",
      ["parent", "sibling", "index"],
      "style",
      "unknown",
      "type"
    ]
  },
  "overrides": [
    {
      "files": ["*.json", "*.jsonc", "*.json5"],
      "options": {
        "trailingComma": "none"
      }
    }
  ],
  "printWidth": 80,
  "ignorePatterns": [
    "pnpm-lock.yaml", // Leave the lockfile untouched to avoid unnecessary diffs
    "*.hbs", // Oxfmt's support for Handlebars sucks
    "**/.pnpm_patches", // Ignore in-progress PNPM patches to avoid unnecessary diffs
    "svelte-frontend" // TODO: Remove once frontend is integrated
  ],
  "sortPackageJson": {
    "sortScripts": true
  }
}
