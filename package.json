{
  "name": "riven-ts",
  "version": "0.0.1",
  "description": "",
  "keywords": [],
  "license": "MIT",
  "author": "Riven Media",
  "type": "module",
  "scripts": {
    "format:check": "oxfmt --check",
    "format:check:ci": "pnpm format:check",
    "format:fix": "oxfmt --write",
    "knip": "pnpm knip:prepare && knip",
    "knip:ci:base": "pnpm knip --cache --no-exit-code",
    "knip:ci:development": "pnpm knip:ci:base --reporter github-actions",
    "knip:ci:production": "pnpm knip:ci:base --strict --reporter json | tail -1 > knip-report.json && jq -e '(.issues // []) | length == 0' knip-report.json > /dev/null",
    "knip:prepare": "turbo codegen:api-schemas",
    "lint": "oxlint --ignore-pattern '{apps,packages}/**'",
    "lint:fix": "pnpm lint --fix",
    "postinstall": "pnpm node .husky/install.mjs || true",
    "test:projects": "vitest run",
    "test:projects:watch": "vitest run --watch",
    "validate-generators": "vitest run -c @repo/core-util-vitest-config -r turbo/generators --no-file-parallelism"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@repo/core-util-oxlint-config": "workspace:^",
    "@repo/core-util-typescript-config": "workspace:^",
    "@repo/core-util-vitest-config": "workspace:^",
    "@turbo/gen": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/browser": "catalog:vitest",
    "es-toolkit": "catalog:",
    "execa": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:vitest"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24"
    }
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
