{
  "name": "@repo/feature-settings",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./resolver": {
      "@repo/source": "./lib/schema/settings.resolver.ts",
      "default": "./dist/schema/settings.resolver.js"
    },
    "./settings.type": {
      "@repo/source": "./lib/schema/types/settings.type.ts",
      "default": "./dist/schema/types/settings.type.js"
    },
    "./enums/log-level.enum": {
      "@repo/source": "./lib/schema/enums/log-level.enum.ts",
      "default": "./dist/schema/enums/log-level.enum.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.lib.json",
    "lint": "oxlint --type-aware --type-check --report-unused-disable-directives-severity=warn",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@repo/util-plugin-sdk": "workspace:^",
    "type-graphql": "catalog:"
  },
  "devDependencies": {
    "@repo/core-util-oxlint-config": "workspace:^",
    "@repo/core-util-typescript-config": "workspace:^",
    "@repo/core-util-vitest-config": "workspace:^",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
