{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tags": ["group:core", "type:util"],
  "tasks": {
    // These tasks read files written by the tasks they depend on. Turborepo hashes
    // inputs before any task runs, so caching them would restore a stale report.
    "collect-json-reports": {
      "cache": false
    },
    "merge-json-reports": {
      "dependsOn": ["collect-json-reports"],
      "cache": false
    },
    "report": {
      "dependsOn": ["merge-json-reports"],
      "cache": false
    }
  }
}
