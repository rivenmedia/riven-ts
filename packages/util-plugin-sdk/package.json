{
  "name": "@repo/util-plugin-sdk",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@repo/source": "./lib/index.ts",
      "default": "./dist/index.js"
    },
    "./types/*": {
      "@repo/source": "./lib/types/*.ts",
      "default": "./dist/types/*.js"
    },
    "./dto/entities": {
      "@repo/source": "./lib/dto/entities/index.ts",
      "default": "./dist/dto/entities/index.js"
    },
    "./dto/enums/*": {
      "@repo/source": "./lib/dto/enums/*.ts",
      "default": "./dist/dto/enums/*.js"
    },
    "./dto/repositories/*": {
      "@repo/source": "./lib/dto/repositories/*.ts",
      "default": "./dist/dto/repositories/*.js"
    },
    "./dto/types/*": {
      "@repo/source": "./lib/dto/types/*.ts",
      "default": "./dist/dto/types/*.js"
    },
    "./dto/unions/*": {
      "@repo/source": "./lib/dto/unions/*.ts",
      "default": "./dist/dto/unions/*.js"
    },
    "./errors/*": {
      "@repo/source": "./lib/errors/*.ts",
      "default": "./dist/errors/*.js"
    },
    "./events": {
      "@repo/source": "./lib/schemas/events/index.ts",
      "default": "./dist/schemas/events/index.js"
    },
    "./schemas/*": {
      "@repo/source": "./lib/schemas/*.ts",
      "default": "./dist/schemas/*.js"
    },
    "./helpers/*": {
      "@repo/source": "./lib/helpers/*.ts",
      "default": "./dist/helpers/*.js"
    },
    "./utilities/*": {
      "@repo/source": "./lib/utilities/*.ts",
      "default": "./dist/utilities/*.js"
    },
    "./validation": {
      "@repo/source": "./lib/validation/index.ts",
      "default": "./dist/validation/index.js"
    },
    "./datasource-context": {
      "@repo/source": "./lib/datasource/context.ts",
      "default": "./dist/datasource/context.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.lib.json",
    "lint": "oxlint --type-aware --type-check --report-unused-disable-directives-severity=warn",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mikro-orm/decorators": "catalog:",
    "@repo/util-rank-torrent-name": "workspace:^",
    "es-toolkit": "catalog:",
    "graphql-scalars": "catalog:",
    "http-status-codes": "catalog:",
    "luxon": "catalog:",
    "type-graphql": "catalog:",
    "zod": "catalog:",
    "zod-validation-error": "catalog:"
  },
  "devDependencies": {
    "@apollo/datasource-rest": "catalog:",
    "@apollo/utils.keyvadapter": "catalog:",
    "@keyv/redis": "catalog:",
    "@mikro-orm/core": "catalog:",
    "@mikro-orm/reflection": "catalog:",
    "@mikro-orm/sqlite": "catalog:",
    "@repo/core-util-oxlint-config": "workspace:^",
    "@repo/core-util-typescript-config": "workspace:^",
    "@repo/core-util-vitest-config": "workspace:^",
    "@types/luxon": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "bullmq": "catalog:",
    "class-validator": "catalog:",
    "msw": "catalog:",
    "oxlint": "catalog:",
    "redis-memory-server": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "winston": "catalog:"
  },
  "peerDependencies": {
    "@apollo/datasource-rest": "catalog:",
    "@mikro-orm/core": "catalog:",
    "bullmq": "catalog:",
    "class-validator": "catalog:"
  }
}
